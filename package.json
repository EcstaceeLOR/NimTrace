{
  "name": "nimtrace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @nimtrace/contracts && npm run build --workspace @nimtrace/web && npm run build --workspace @nimtrace/api",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:migrate:local": "npm run db:migrate:local --workspace @nimtrace/api",
    "db:migrate:preview": "npm run db:migrate:preview --workspace @nimtrace/api",
    "deploy:api": "npm run deploy --workspace @nimtrace/api",
    "dev:api": "npm run dev --workspace @nimtrace/api",
    "dev:web": "npm run dev --workspace @nimtrace/web",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test:unit --workspaces --if-present",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260914.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.2"
  }
}
