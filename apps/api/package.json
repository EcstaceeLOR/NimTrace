{
  "name": "@nimtrace/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:preview": "wrangler d1 migrations apply DB --preview --remote",
    "dev": "wrangler dev --port 8787",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nimiq/core": "2.21.0",
    "@nimtrace/contracts": "*",
    "hono": "^4.13.7"
  }
}
