{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nimtrace-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["*/1 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nimtrace-db",
      "database_id": "5a3ca574-228f-4db7-990b-2f1fa7c90dc6",
      "preview_database_id": "2547d41c-e23e-4006-938b-99db39d27f3b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",
      "bucket_name": "nimtrace-images",
      "preview_bucket_name": "nimtrace-images-preview"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "APP_VERSION": "0.1.0",
    "NIMIQ_NETWORK": "main-albatross",
    "CORS_ORIGIN": "https://nimtrace.vercel.app"
  }
}
